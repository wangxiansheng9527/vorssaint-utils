<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Finder only loads sandboxed extensions. This one reads nothing of the
	     user's and writes nothing: it shows a menu and reports clicks to the app. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
